<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================= -->
    <!-- DEPARTMENT VIEWS              -->
    <!-- ============================= -->

    <record id="view_aquaddis_department_tree" model="ir.ui.view">
        <field name="name">aquaddis.department.tree</field>
        <field name="model">aquaddis.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_aquaddis_department_form" model="ir.ui.view">
        <field name="name">aquaddis.department.form</field>
        <field name="model">aquaddis.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>

                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="job_title"/>
                                    <field name="email"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ============================= -->
    <!-- EMPLOYEE VIEWS                -->
    <!-- ============================= -->

    <record id="view_aquaddis_employee_tree" model="ir.ui.view">
        <field name="name">aquaddis.employee.tree</field>
        <field name="model">aquaddis.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_aquaddis_employee_form" model="ir.ui.view">
        <field name="name">aquaddis.employee.form</field>
        <field name="model">aquaddis.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="job_title"/>
                            <field name="department_id"/>
                            <field name="hire_date"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ============================= -->
    <!-- WINDOW ACTIONS                -->
    <!-- ============================= -->

    <record id="action_aquaddis_departments" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">aquaddis.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_aquaddis_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">aquaddis.employee</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- ============================= -->
    <!-- MENUS                          -->
    <!-- ============================= -->

    <menuitem
        id="menu_aquaddis_root"
        name="AQUADDIS Management"
        sequence="10"
    />

    <menuitem
        id="menu_aquaddis_departments"
        name="Departments"
        parent="menu_aquaddis_root"
        action="action_aquaddis_departments"
        sequence="10"
    />

    <menuitem
        id="menu_aquaddis_employees"
        name="Employees"
        parent="menu_aquaddis_root"
        action="action_aquaddis_employees"
        sequence="20"
    />

</odoo>
